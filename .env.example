# Copy to .env for local Docker Compose overrides.
# Values here are development samples only. Do not commit real secrets.

POSTGRES_DB=skishop
POSTGRES_USER=skishop
POSTGRES_PASSWORD=skishop-local-password
POSTGRES_PORT=5432

BACKEND_PORT=8080
FRONTEND_PORT=3000

ADMIN_USERNAME=admin@example.com
# Spring Security encoded password. The demo value lets you log in with "change-me".
ADMIN_PASSWORD={noop}change-me
ADMIN_TOKEN_TTL=PT8H

CORS_ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
INTERNAL_API_BASE_URL=http://backend:8080

# Leave empty to use the backend AI fallback path.
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
